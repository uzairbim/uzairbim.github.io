---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { expertise } from '../data/expertise';
import { lab, labShots } from '../data/lab';
import { url } from '../lib/url';
import { colour } from '../lib/code';
import { heroCode } from '../data/heroCode';
import CodeBackdrop from '../components/CodeBackdrop.astro';

// Featured projects, in the order they appear in the editorial grid.
const featuredIds = ['four-seasons-jeddah', 'ilmi-center-misk-city', 'tabuk-entertainment-complex', 'six-flags-qiddiya'];
const work = await getCollection('work', (w) => !w.data.hidden);
const featured = featuredIds.map((id) => work.find((w) => w.id === id)).filter((w) => w !== undefined);

// Six headline certificates. The full list lives on /certificates/.
const certIds = ['iso-19650', 'bim-asset-information-professional', 'revizto-level-3', 'procore', 'canbim-s4', 'coursera-bim-fundamentals'];
const allCerts = await getCollection('certificates');
const certs = certIds.map((id) => allCerts.find((c) => c.id === id)).filter((c) => c !== undefined);

const proof = [
  { value: '5+ yrs', label: 'BIM delivery since Dec 2019' },
  { value: '4', label: 'Projects in KSA, USA and Pakistan' },
  { value: 'ISO 19650', label: '4 BSI Training Academy certificates' },
  { value: 'Level 3', label: 'Revizto Elite Expert' },
  { value: 'LOD 400', label: 'Construction models and shop drawings' },
];

const heroLines = colour(heroCode).split('\n');
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base>
  <CodeBackdrop />
  <!-- HERO -->
  <section class="hero blueprint" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-text">
        {profile.openToWork && (
          <p class="avail anim" style="--d:0"><span class="avail-dot" aria-hidden="true"></span>{profile.openToWorkLabel}</p>
        )}
        <h1 id="hero-title" class="anim" style="--d:1">{profile.name}</h1>
        <p class="hero-title anim" style="--d:2">BIM Engineer <span class="bar" aria-hidden="true">|</span><span class="sr-only">and</span> BIM Coordinator</p>
        <p class="hero-lede anim" style="--d:3">{profile.positioning}</p>
        <div class="hero-cta anim" style="--d:4">
          <a class="btn btn-primary btn-lg" href="#projects">Explore Projects <span aria-hidden="true">↓</span></a>
          <a class="btn btn-ghost btn-lg" href={url(profile.cv)} target="_blank" rel="noopener">Download CV</a>
        </div>
        <div class="hero-contact anim" style="--d:5">
          <p class="loc">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            {profile.location}
          </p>
          <ul class="contact-row" aria-label="Contact">
            <li><a href={profile.linkedin} target="_blank" rel="noopener">
              <svg class="fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.6 4.77 6V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4z"/></svg>
              LinkedIn</a></li>
            <li><a href={`mailto:${profile.email}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
              Email</a></li>
            <li><a href={profile.whatsapp} target="_blank" rel="noopener">
              <svg class="fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.13-1.35A9.9 9.9 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.8.81-2.96-.2-.3a8.2 8.2 0 1 1 6.91 3.8zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.17.25-.64.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25 0-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.3-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.66.3 2.76 2.76 0 0 0-.86 2.06c0 1.21.88 2.38 1 2.55.13.16 1.74 2.65 4.2 3.72.59.25 1.05.4 1.4.52.6.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.2-.57.2-1.07.15-1.17-.06-.1-.23-.17-.48-.29z"/></svg>
              WhatsApp</a></li>
            <li><a href={profile.portfolioLink} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
              Full Portfolio</a></li>
          </ul>
        </div>
      </div>
      <figure class="hero-photo anim" style="--d:2">
        <div class="photo-frame">
          <div class="code-panel" aria-hidden="true">
            <div class="cp-bar"><span></span><span></span><span></span><em>Python Script · Dynamo</em></div>
            <pre class="cp-code">{heroLines.map((l, i) => <span class="cp-line"><b>{i + 1}</b><Fragment set:html={l || ' '} /></span>)}<span class="cp-line"><b>{heroLines.length + 1}</b><span class="caret"></span></span></pre>
          </div>
          <span class="corner br" aria-hidden="true"></span>
          <img class="photo-person" src={url(profile.heroPhoto)} alt={`Portrait of ${profile.name}`} width="302" height="680" fetchpriority="high" />
        </div>
        <figcaption class="label">Behind: Revit API Python in a Dynamo Python Script node</figcaption>
      </figure>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section id="proof" class="proof" aria-label="Key facts">
    <div class="container">
      <dl class="proof-row">
        {proof.map((p) => (
          <div><dt>{p.value}</dt><dd>{p.label}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 01 FEATURED PROJECTS -->
  <section id="projects" class="section projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="num">01</span>Featured projects</span>
          <h2 id="projects-title">Hotels, cultural venues and giga-projects across the Kingdom.</h2>
        </div>
        <p>My role on each project, the scope I modelled and the tools I used. Cover images are project renders; my own model views are in each case study.</p>
      </div>
      <div class="pgrid">
        {featured.map((p, i) => {
          const d = p.data;
          return (
            <article class:list={['pcard', 'reveal', i === 0 || i === 3 ? 'wide' : 'narrow']}>
              <a class="pmedia" href={url(`/work/${p.id}/`)} tabindex="-1" aria-hidden="true">
                {d.cover && <img src={url(d.cover)} alt="" loading="lazy" />}
                <span class="credit label">Project render</span>
              </a>
              <div class="pbody">
                <p class="pmeta label"><span class="num">{pad(i + 1)}</span>{d.category}<span class="dot" aria-hidden="true">·</span>{d.location}</p>
                <h3><a href={url(`/work/${p.id}/`)}>{d.title}</a></h3>
                <dl class="facts">
                  {d.client && <div><dt>Employer</dt><dd>{d.client}</dd></div>}
                  {d.role && <div><dt>My role</dt><dd>{d.role}</dd></div>}
                  {(d.scope || d.lod) && <div><dt>Scope</dt><dd>{[d.scope, d.lod].filter(Boolean).join(' · ')}</dd></div>}
                  {d.period && <div><dt>Period</dt><dd>{d.period}</dd></div>}
                </dl>
                <ul class="chips">{d.software.slice(0, 6).map((s) => <li class="chip">{s}</li>)}</ul>
                <a class="link-arrow pmore" href={url(`/work/${p.id}/`)} aria-label={`Read the ${d.title} case study`}>Read case study <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
      <div class="more-row reveal">
        <a class="btn btn-outline" href={url('/work/')}>All projects <span aria-hidden="true">→</span></a>
        <a class="link-arrow" href={profile.portfolioLink} target="_blank" rel="noopener">Full portfolio on Canva ↗</a>
      </div>
    </div>
  </section>

  <!-- 02 EXPERTISE -->
  <section id="expertise" class="section expertise" aria-labelledby="expertise-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="num">02</span>BIM expertise</span>
          <h2 id="expertise-title">Six disciplines, shown with real screens from my work.</h2>
        </div>
        <p>Pick an area to see the screenshot, with numbered notes on what each part shows.</p>
      </div>

      <div class="tabs reveal" data-tabs>
        <div class="tablist" role="tablist" aria-label="BIM expertise areas">
          {expertise.map((e, i) => (
            <button type="button" role="tab" id={`tab-${e.id}`} aria-controls={`panel-${e.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="tnum">{pad(i + 1)}</span>{e.label}
            </button>
          ))}
        </div>

        {expertise.map((e, i) => (
          <div class="panel" role="tabpanel" id={`panel-${e.id}`} aria-labelledby={`tab-${e.id}`} data-active={i === 0 ? 'true' : 'false'}>
            <figure class="shot">
              <div class="shot-frame">
                <img src={url(e.image)} alt={e.alt} loading="lazy" />
                {e.callouts.map((c, n) => (
                  <span class="pin" style={`left:${c.x}%;top:${c.y}%`} data-pin={n + 1} aria-hidden="true">{n + 1}</span>
                ))}
              </div>
              <figcaption class="label">{e.caption}</figcaption>
            </figure>
            <div class="ptext">
              <h3>{e.title}</h3>
              <p>{e.text}</p>
              <ol class="legend" aria-label="Notes on the screenshot">
                {e.callouts.map((c, n) => <li data-pin={n + 1}><span class="lnum" aria-hidden="true">{n + 1}</span>{c.text}</li>)}
              </ol>
              <ul class="points">{e.points.map((pt) => <li>{pt}</li>)}</ul>
              <ul class="chips">{e.tools.map((t) => <li class="chip">{t}</li>)}</ul>
              {e.link && <a class="link-arrow" href={e.link.href.startsWith('#') ? e.link.href : url(e.link.href)}>{e.link.label} <span aria-hidden="true">→</span></a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 AUTOMATION LAB -->
  <section id="lab" class="section lab blueprint" aria-labelledby="lab-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="num">03</span>Automation Lab</span>
          <h2 id="lab-title">Scripts and tools I have built to take repetitive work off the team.</h2>
        </div>
        <p>Each entry says whether it was used on a live project or is still an experiment. Time savings are only quoted where they were measured.</p>
      </div>
      <div class="lab-grid">
        <div class="lab-shots">
          {labShots.map((s) => (
            <figure class="lab-shot reveal">
              <img src={url(s.image)} alt={s.alt} loading="lazy" />
              <figcaption class="label">{s.caption}</figcaption>
            </figure>
          ))}
        </div>
        <ol class="lab-list">
          {lab.map((l, i) => (
            <li class="lab-item reveal">
              <div class="lab-top">
                <span class="tnum">{pad(i + 1)}</span>
                <span class:list={['status', l.status === 'Experiment' ? 'exp' : 'live']}>{l.status}</span>
              </div>
              <h3>{l.title}</h3>
              {l.context && <p class="lab-ctx">{l.context}</p>}
              <dl class="lab-dl">
                {l.problem && <div><dt>Problem</dt><dd>{l.problem}</dd></div>}
                <div><dt>{l.status === 'Experiment' ? 'What it does' : 'Solution'}</dt><dd>{l.solution}</dd></div>
              </dl>
              <ul class="chips">{l.tools.map((t) => <li class="chip">{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 04 CAREER -->
  <section id="career" class="section career" aria-labelledby="career-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="num">04</span>Career</span>
          <h2 id="career-title">Six roles, from Islamabad to Jeddah.</h2>
        </div>
        <a class="link-arrow" href={url('/about/')}>Full experience <span aria-hidden="true">→</span></a>
      </div>
      <ol class="timeline reveal">
        {profile.experience.map((e) => (
          <li>
            <span class="t-when label">{e.period}</span>
            <span class="t-dot" aria-hidden="true"></span>
            <h3>{e.role}</h3>
            <p class="t-co">{e.company}</p>
            <p class="t-proj">{e.project}</p>
            <p class="t-place label">{e.place}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 CREDENTIALS -->
  <section id="credentials" class="section creds" aria-labelledby="creds-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="num">05</span>Credentials</span>
          <h2 id="creds-title">Education and certificates.</h2>
        </div>
        <a class="link-arrow" href={url('/certificates/')}>All certificates <span aria-hidden="true">→</span></a>
      </div>
      <ul class="edu reveal">
        {profile.education.slice(0, 2).map((e) => (
          <li><span class="label">{e.org}</span><strong>{e.title}</strong></li>
        ))}
      </ul>
      <ul class="cert-grid">
        {certs.map((c) => (
          <li class="cert reveal">
            {c.data.image && (
              <div class="cert-img"><img src={url(c.data.image)} alt={`${c.data.title} certificate`} loading="lazy" /></div>
            )}
            <div class="cert-body">
              <p class="label">{c.data.issuer}</p>
              <h3>{c.data.title}</h3>
              {c.data.date && <p class="cert-date">{c.data.date}</p>}
              {c.data.link && <a class="link-arrow" href={c.data.link} target="_blank" rel="noopener">Verify <span aria-hidden="true">↗</span></a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 CONTACT -->
  <section id="contact" class="contact-band" aria-labelledby="contact-title">
    <div class="container cb-grid">
      <div class="cb-text reveal">
        <span class="eyebrow"><span class="num">06</span>Contact</span>
        <h2 id="contact-title">Let’s talk about your next project.</h2>
        <p class="cb-avail"><span class="pulse" aria-hidden="true"></span>Open to BIM Engineer and BIM Coordinator roles · {profile.availability} · {profile.noticePeriod} notice · Based in {profile.location}</p>
        <a class="cb-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="cb-cta">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn btn-ghost" href={url(profile.cv)} target="_blank" rel="noopener">Download CV</a>
        </div>
        <ul class="cb-links">
          <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
          <li><a href={profile.portfolioLink} target="_blank" rel="noopener">Full portfolio (Canva) ↗</a></li>
          <li><a href={url('/contact/')}>All contact details →</a></li>
        </ul>
      </div>
      <div class="cb-photo" aria-hidden="true">
        <img src={url(profile.photo)} alt="" loading="lazy" width="282" height="910" />
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Accessible tabs for the expertise section (arrow keys, Home and End).
  // Without JavaScript every panel is shown, one after another.
  document.querySelectorAll('[data-tabs]').forEach(function (root) {
    root.classList.add('ready');
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    function select(i, focus) {
      tabs.forEach(function (t, j) {
        var on = i === j;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).setAttribute('data-active', on ? 'true' : 'false');
      });
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(i, false); });
      t.addEventListener('keydown', function (e) {
        var n = tabs.length, k = e.key, to = null;
        if (k === 'ArrowRight' || k === 'ArrowDown') to = (i + 1) % n;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') to = (i - 1 + n) % n;
        else if (k === 'Home') to = 0;
        else if (k === 'End') to = n - 1;
        if (to !== null) { e.preventDefault(); select(to, true); }
      });
    });
    // Hovering a note highlights its number on the screenshot.
    root.querySelectorAll('.panel').forEach(function (panel) {
      panel.querySelectorAll('.legend li').forEach(function (li) {
        var pin = panel.querySelector('.pin[data-pin="' + li.dataset.pin + '"]');
        li.addEventListener('mouseenter', function () { pin && pin.classList.add('hot'); });
        li.addEventListener('mouseleave', function () { pin && pin.classList.remove('hot'); });
      });
    });
  });
</script>

<style>
  /* The page-wide code background sits inside main; keep main and the footer above the page colour. */
  :global(#main), :global(.site-footer) { position: relative; z-index: 1; }

  /* ---------- Hero ---------- */
  .hero {
    position: relative; overflow: hidden; background-color: transparent;
    min-height: min(calc(100svh - 69px), 860px);
    display: flex; align-items: center;
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 70% at 78% 45%, rgba(59,191,178,.07), transparent 70%);
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 56px; align-items: center; }
  .avail {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px;
    padding: 7px 14px 7px 12px; border-radius: 999px;
    border: 1px solid rgba(92, 201, 138, .32); background: rgba(92, 201, 138, .07);
    color: #BFE8CF; font-size: .9rem; font-weight: 500;
  }
  .avail-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: #5CC98A; flex: 0 0 auto; }
  .hero h1 {
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5rem); font-weight: 800;
    line-height: 1; letter-spacing: -.035em; margin: 0 0 16px;
  }
  .hero-title {
    font-family: var(--display); font-weight: 600;
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2.1rem); line-height: 1.2; letter-spacing: -.015em;
    color: var(--ink-2); margin: 0 0 26px;
  }
  .hero-title .bar { color: var(--accent); font-weight: 400; margin: 0 .2em; }
  .hero-lede { color: var(--ink-2); font-size: clamp(1.06rem, .95rem + .35vw, 1.25rem); line-height: 1.7; max-width: 38em; margin: 0 0 32px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .btn-lg { padding: 14px 24px; font-size: 1rem; min-height: 50px; }
  .hero-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .loc { display: inline-flex; align-items: center; gap: 7px; margin: 0; font-size: .95rem; color: var(--muted); }
  .loc svg { width: 16px; height: 16px; fill: none; stroke: var(--bronze-ink); stroke-width: 1.8; }
  .contact-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .contact-row a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 8px 14px;
    border: 1px solid var(--line-2); border-radius: 999px; background: rgba(21,36,58,.5);
    color: var(--ink-2); font-size: .9rem; font-weight: 500; text-decoration: none;
    transition: border-color .2s, color .2s, background .2s;
  }
  .contact-row a:hover { border-color: var(--accent); color: var(--ink); background: rgba(59,191,178,.08); }
  .contact-row svg { width: 16px; height: 16px; fill: none; stroke: var(--accent-ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }
  .contact-row svg.fill { fill: var(--accent-ink); stroke: none; }

  .hero-photo { margin: 0; justify-self: end; width: 100%; max-width: 460px; }
  .photo-frame {
    position: relative; overflow: hidden; isolation: isolate;
    aspect-ratio: 4 / 5; max-height: min(600px, calc(100svh - 230px)); margin-left: auto;
    border-radius: 18px; border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.6);
  }
  .code-panel {
    position: absolute; inset: 0; z-index: -2; display: flex; flex-direction: column;
    background: #0D1622;
  }
  .cp-bar {
    display: flex; align-items: center; gap: 6px; padding: 10px 14px;
    background: #111D2C; border-bottom: 1px solid var(--line-2);
  }
  .cp-bar span { width: 9px; height: 9px; border-radius: 50%; background: #2C3D52; }
  .cp-bar span:first-child { background: rgba(214,168,122,.7); }
  .cp-bar em { margin-left: 8px; font-style: normal; font-family: var(--mono); font-size: .66rem; letter-spacing: .04em; color: var(--muted); }
  .cp-code {
    margin: 0; padding: 12px 0; flex: 1; overflow: hidden;
    font-family: var(--mono); font-size: 11.5px; line-height: 1.72; color: rgba(214, 220, 228, .82);
    white-space: pre;
  }
  .cp-line { display: block; padding-right: 12px; }
  .cp-line b { display: inline-block; width: 30px; margin-right: 12px; text-align: right; font-weight: 400; color: rgba(163,175,189,.38); }
  .cp-code :global(i) { font-style: normal; }
  .cp-code :global(.k) { color: #5FD3C6; }
  .cp-code :global(.s) { color: #D6A87A; }
  .cp-code :global(.c) { color: rgba(163,175,189,.62); }
