---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const work = await getCollection('work', (w) => !w.data.hidden);
  return work.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const facts = [
  ['Role', d.role], ['Client', d.client], ['Location', d.location],
  ['Period', d.period], ['Scope', d.scope], ['Level of detail', d.lod],
].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary}>
  <section class="page-hero blueprint">
    <div class="container">
      <a class="back" href={url('/work/')}>← All work</a>
      <div class="eyebrow">{d.category}</div>
      <h1>{d.title}</h1>
      <p>{d.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <div class="main">
        <div class="hero-img"><Cover src={d.cover} alt={d.title} label={d.cover ? undefined : "Project image coming soon"} tall /></div>
        <div class="prose"><Content /></div>

        {d.images.length > 0 && (
          <div class="gallery">
            {d.images.map((src) => (
              <a href={url(src)} target="_blank" rel="noopener"><img src={url(src)} alt={`${d.title} image`} loading="lazy" /></a>
            ))}
          </div>
        )}

        {d.pdf && (
          <div class="pdf">
            <div class="pdf-head">
              <h2>Drawings (PDF)</h2>
              <a class="btn btn-outline" href={url(d.pdf)} target="_blank" rel="noopener">Open / download PDF</a>
            </div>
            <object data={url(d.pdf)} type="application/pdf" aria-label={`${d.title} PDF`}>
              <p class="muted">Your browser can't show the PDF here. Use the button above to open it.</p>
            </object>
          </div>
        )}
      </div>

      <aside class="facts">
        <dl>
          {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        {d.software.length > 0 && (
          <div>
            <h3>Tools</h3>
            <ul class="chips">{d.software.map((s) => <li class="chip">{s}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .back { display: inline-block; color: #b8c6d6; text-decoration: none; font-size: .9rem; margin-bottom: 18px; }
  .back:hover { color: #fff; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
  .hero-img { border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; border: 1px solid var(--line); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-top: 32px; }
  .gallery img { border-radius: 10px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border: 1px solid var(--line); }
  .pdf { margin-top: 40px; }
  .pdf-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .pdf-head h2 { margin: 0; font-size: 1.3rem; }
  .pdf object { width: 100%; height: 80vh; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .facts { position: sticky; top: 92px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow); display: grid; gap: 20px; }
  .facts dl { margin: 0; display: grid; gap: 14px; }
  .facts dt { font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-weight: 600; }
  .facts dd { margin: 2px 0 0; font-weight: 500; }
  .facts h3 { font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-family: var(--font); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .facts { position: static; order: -1; }
    .pdf object { height: 60vh; }
  }
</style>
