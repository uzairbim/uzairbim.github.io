---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';
import CertCard from '../components/CertCard.astro';

const entries = (await getCollection('certificates')).sort((a, b) => a.data.order - b.data.order);
const certs = await Promise.all(entries.map(async (c) => ({ ...c, Content: (await render(c)).Content })));
// Grouped certificates (e.g. ISO 19650) first, then everything else
const groupNames = [...new Set(certs.map((c) => c.data.group).filter(Boolean))];
const sections = [
  ...groupNames.map((g) => ({ title: g, items: certs.filter((c) => c.data.group === g), grouped: true })),
  { title: groupNames.length ? 'Other certifications' : '', items: certs.filter((c) => !c.data.group), grouped: false },
].filter((s) => s.items.length);
// Small groups (1 or 2 certificates) share a 3-column row, each with its own heading
const blocks = [];
for (const s of sections) {
  const small = s.grouped && s.items.length <= 2;
  const last = blocks[blocks.length - 1];
  const used = last?.solo ? last.sections.reduce((n, x) => n + x.items.length, 0) : 0;
  if (small && last?.solo && used + s.items.length <= 3) last.sections.push(s);
  else blocks.push(small ? { solo: true, sections: [s] } : { solo: false, section: s });
}
---
<Base title="Certificates" description="Professional certifications in BIM, information management and construction.">
  <section class="page-hero blueprint">
    <div class="container">
      <div class="eyebrow">Certificates</div>
      <h1>Certifications &amp; training</h1>
      <p>Professional certifications in BIM, ISO 19650 information management, coordination tools and construction safety. Open any certificate to view the PDF.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {blocks.map((b) => b.solo ? (
        <div class="cert-group solo-row">
          {b.sections.map((s) => (
            <div class="solo" style={`--span:${s.items.length}`}>
              <h2 class="group-title">{s.title}</h2>
              <div class="solo-cards">{s.items.map((c) => <CertCard cert={c} />)}</div>
            </div>
          ))}
        </div>
      ) : ((s) => (
        <div class="cert-group">
          {s.title && <h2 class="group-title">{s.title}</h2>}
          <div class:list={['grid', { pair: s.grouped && s.items.length % 2 === 0 }]}>
            {s.items.map((c) => (
              <CertCard cert={c} />
            ))}
          </div>
        </div>
      ))(b.section))}
      <p class="more muted">
        More certificates are in my <a href={profile.certificatesLink} target="_blank" rel="noopener">certificate folder</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .cert-group + .cert-group { margin-top: 48px; }
  .group-title { margin: 0 0 20px; padding-left: 14px; border-left: 4px solid var(--accent); }
  .grid.pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 760px) { .grid.pair { grid-template-columns: 1fr; } }
  .solo-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .solo { display: flex; flex-direction: column; grid-column: span var(--span); }
  .solo-cards { flex: 1; display: grid; gap: 22px; grid-template-columns: repeat(var(--span), minmax(0, 1fr)); }
  @media (max-width: 960px) {
    .solo-row { grid-template-columns: 1fr; }
    .solo { grid-column: auto; }
    .solo-cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  }
  .more { margin-top: 32px; }
  .more a { color: var(--accent-ink); }
</style>
