---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { profile } from '../data/profile';
import CertCard from '../components/CertCard.astro';
import { categories, categoryOf, categoryOrder, featuredIds, areaOf, organisationOf } from '../data/certMeta';

const entries = await getCollection('certificates');
const certs = await Promise.all(entries.map(async (c) => ({ ...c, Content: (await render(c)).Content })));

// Gallery order: by category, then by each certificate's own order.
// Certificates without a copy on the site go last.
const gallery = [...certs].sort((a, b) =>
  Number(!a.data.image) - Number(!b.data.image)
  || categoryOrder.indexOf(categoryOf(a.data)) - categoryOrder.indexOf(categoryOf(b.data))
  || a.data.order - b.data.order);
const featured = featuredIds.map((id) => certs.find((c) => c.id === id)).filter((c) => c !== undefined);
const isFeatured = (id: string) => featuredIds.includes(id);

// Summary figures, all counted from the certificate files.
const total = certs.length;
const organisations = new Set(certs.map((c) => organisationOf(c.data)).filter(Boolean)).size;
const areas = [...new Set(certs.map((c) => areaOf(c.id, c.data)))];
const counts = Object.fromEntries(categories.map((k) => [k.id, k.id === 'all' ? total : certs.filter((c) => categoryOf(c.data) === k.id).length]));
const isoCount = counts.iso;
// Three real certificates fanned out beside the heading on wide screens (decorative).
const fan = ['revizto-level-3', 'canbim-s4', 'bim-project-information-practitioner']
  .map((id) => certs.find((c) => c.id === id)?.data.image)
  .filter((i): i is string => Boolean(i))
  .map((i) => i.replace('/uploads/certificates/', '/uploads/certificates/thumbs/').replace(/\.jpg$/, '-640.webp'));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Certificates" description="Professional certifications in BIM, ISO 19650 information management, digital coordination, construction technology and project delivery.">
  <!-- HEADER -->
  <section class="cert-hero blueprint">
    <div class="container hero-wrap">
      <div class="fan" aria-hidden="true">
        {fan.map((src, i) => <img src={url(src)} alt="" width="640" height="452" style={`--k:${i}`} />)}
      </div>
      <span class="eyebrow">Certificates</span>
      <h1>Credentials That Back <span>the Expertise.</span></h1>
      <p class="lede">Professional certifications in BIM, ISO 19650 information management, digital coordination, construction technology, and project delivery.</p>
      <dl class="stats">
        <div><dt>Certificates</dt><dd data-count={total}>{total}</dd></div>
        <div><dt>Issuing organisations</dt><dd data-count={organisations}>{organisations}</dd></div>
        <div><dt>Areas of specialisation</dt><dd data-count={areas.length}>{areas.length}</dd></div>
      </dl>
      <ul class="areas" aria-label="Areas of specialisation">
        {areas.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section featured" aria-labelledby="feat-title">
    <div class="container">
      <div class="feat-head">
        <div>
          <span class="eyebrow"><span class="num">01</span>Featured credentials</span>
          <h2 id="feat-title">ISO 19650 at the core.</h2>
          <p>The complete set of {isoCount} BSI Training Academy ISO 19650 certifications, Revizto's highest expert level and CanBIM's proficient software skills certificate.</p>
        </div>
        <div class="feat-nav">
          <span class="feat-count" aria-hidden="true"><b data-feat-current>01</b> / {pad(featured.length)}</span>
          <button class="nav-btn" type="button" data-feat-prev aria-label="Previous featured certificate">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button class="nav-btn" type="button" data-feat-next aria-label="Next featured certificate">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="feat-viewport">
      <ul class="feat-track" data-feat-track tabindex="0" aria-label="Featured credentials, scroll sideways for more">
        {featured.map((c, i) => (
          <li class:list={['feat-item', { iso: categoryOf(c.data) === 'iso' }]}>
            {i === 0 && <span class="series label" aria-hidden="true">ISO 19650 series · BSI Training Academy</span>}
            {i === isoCount && <span class="series label" aria-hidden="true">Coordination &amp; software skills</span>}
            <CertCard cert={c} variant="featured" index={i} />
          </li>
        ))}
      </ul>
    </div>
    <div class="container">
      <div class="feat-progress" aria-hidden="true"><span data-feat-bar></span></div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section gallery-section" aria-labelledby="all-title">
    <div class="container">
      <div class="gal-head">
        <span class="eyebrow"><span class="num">02</span>Full gallery</span>
        <h2 id="all-title">Every certificate, by issuer.</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter certificates">
        {categories.map((k, i) => (
          <button type="button" class="filter" data-filter={k.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {k.label}<span class="fcount">{counts[k.id]}</span>
          </button>
        ))}
      </div>
      <p class="status" data-status aria-live="polite">
        Showing {total - featured.length} certificates. The {featured.length} featured above are not repeated here.
      </p>
      <div class="gallery" data-gallery data-filter="all">
        {gallery.map((c, i) => <CertCard cert={c} featured={isFeatured(c.id)} index={i} />)}
      </div>
      <p class="empty-state" data-empty hidden>No certificates in this category yet.</p>
      <p class="more">
        Original files for more certificates are in my <a href={profile.certificatesLink} target="_blank" rel="noopener">certificate folder on Google Drive ↗</a>
      </p>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <dialog class="lb" data-lb aria-labelledby="lb-title">
    <div class="lb-inner">
      <header class="lb-head">
        <div>
          <p class="lb-issuer label" data-lb-issuer></p>
          <h2 id="lb-title" data-lb-title></h2>
        </div>
        <button class="lb-close" type="button" data-lb-close aria-label="Close certificate">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="lb-stage" data-lb-stage>
        <p class="lb-loading" data-lb-loading>Loading certificate…</p>
        <p class="lb-error" data-lb-error hidden>The preview could not load. <a data-lb-error-link href="#" target="_blank" rel="noopener">Open the certificate file ↗</a></p>
        <img data-lb-img alt="" />
      </div>
      <footer class="lb-foot">
        <div class="lb-info">
          <p class="lb-date" data-lb-date></p>
          <div class="lb-detail" data-lb-detail></div>
        </div>
        <div class="lb-actions">
          <button class="btn btn-outline lb-zoom" type="button" data-lb-zoom aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4M11 8v6M8 11h6"/></svg>
            <span data-lb-zoom-label>Zoom in</span>
          </button>
          <a class="btn btn-outline" data-lb-open href="#" target="_blank" rel="noopener">Open full-size image ↗</a>
          <a class="btn btn-primary" data-lb-verify href="#" target="_blank" rel="noopener">Verify credential ↗</a>
          <span class="lb-step">
            <button class="nav-btn" type="button" data-lb-prev aria-label="Previous certificate"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="nav-btn" type="button" data-lb-next aria-label="Next certificate"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
          </span>
        </div>
      </footer>
    </div>
  </dialog>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  // ---------- Scroll reveal ----------
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.tile'));
  if ('IntersectionObserver' in window && !reduce.matches) {
    document.documentElement.classList.add('cert-anim');
    const io = new IntersectionObserver((list) => {
      let n = 0;
      list.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.style.transitionDelay = `${Math.min(n++, 4) * 70}ms`;
        el.classList.add('seen');
        el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
        io.unobserve(el);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    tiles.forEach((t) => io.observe(t));
  }

  // ---------- Count-up for the summary figures (runs once) ----------
  if (!reduce.matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 900);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  // ---------- Hover tilt (mouse only, motion allowed) ----------
  tiles.forEach((tile) => {
    let frame = 0;
    tile.addEventListener('pointermove', (e) => {
      if (!finePointer.matches || reduce.matches || e.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = tile.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tile.style.transform = `perspective(1000px) rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg) translateY(-4px)`;
      });
    });
    tile.addEventListener('pointerleave', () => { cancelAnimationFrame(frame); tile.style.transform = ''; });
  });

  // ---------- Featured row ----------
  const track = document.querySelector<HTMLElement>('[data-feat-track]');
  const bar = document.querySelector<HTMLElement>('[data-feat-bar]');
  const current = document.querySelector<HTMLElement>('[data-feat-current]');
  const prev = document.querySelector<HTMLButtonElement>('[data-feat-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-feat-next]');
  if (track && bar && current && prev && next) {
    const items = Array.from(track.children) as HTMLElement[];
    const stepSize = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth);
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      const p = max > 0 ? track.scrollLeft / max : 1;
      const visible = Math.max(1, Math.round(track.clientWidth / stepSize()));
      bar.style.transform = `scaleX(${Math.max(visible / items.length, p).toFixed(3)})`;
      const idx = Math.min(items.length, Math.round(track.scrollLeft / stepSize()) + 1);
      current.textContent = String(idx).padStart(2, '0');
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft > max - 4;
    };
    const go = (dir: number) => track.scrollBy({ left: dir * stepSize(), behavior: reduce.matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.target !== track) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });
    window.addEventListener('resize', sync);
    sync();
  }

  // ---------- Category filters ----------
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const labelOf = (id: string) => buttons.find((b) => b.dataset.filter === id)?.firstChild?.textContent?.trim() ?? '';
  const visibleTiles = () => Array.from(gallery?.querySelectorAll<HTMLElement>('.tile') ?? []).filter((t) => t.offsetParent !== null);
  const applyFilter = (id: string) => {
    if (!gallery || !status || !empty) return;
    gallery.dataset.filter = id;
    gallery.querySelectorAll<HTMLElement>('.tile').forEach((t) => {
      const show = id === 'all' ? !t.dataset.featured : t.dataset.cat === id;
      t.hidden = !show;
    });
    const n = visibleTiles().length;
    empty.hidden = n > 0;
    status.textContent = id === 'all'
      ? `Showing ${n} certificates. The ${document.querySelectorAll('.feat-item').length} featured above are not repeated here.`
      : id === 'other'
        ? `Showing ${n} other certificate${n === 1 ? '' : 's'}.`
        : `Showing ${n} ${labelOf(id)} certificate${n === 1 ? '' : 's'}.`;
  };
  buttons.forEach((b) => b.addEventListener('click', () => {
    if (b.getAttribute('aria-pressed') === 'true' || !gallery) return;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const id = b.dataset.filter ?? 'all';
    if (reduce.matches) { applyFilter(id); return; }
    gallery.classList.add('switching');
    window.setTimeout(() => {
      applyFilter(id);
      visibleTiles().forEach((t, i) => { t.classList.add('seen'); t.style.setProperty('--n', String(Math.min(i, 8))); });
      gallery.classList.remove('switching');
      gallery.classList.add('entering');
      window.setTimeout(() => gallery.classList.remove('entering'), 600);
    }, 180);
  }));
  applyFilter('all');

  // ---------- Lightbox ----------
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (lb && typeof lb.showModal === 'function') {
    const q = <T extends HTMLElement>(s: string) => lb.querySelector<T>(s)!;
    const img = q<HTMLImageElement>('[data-lb-img]');
    const stage = q<HTMLElement>('[data-lb-stage]');
    const loading = q<HTMLElement>('[data-lb-loading]');
    const error = q<HTMLElement>('[data-lb-error]');
    const errorLink = q<HTMLAnchorElement>('[data-lb-error-link]');
    const zoom = q<HTMLButtonElement>('[data-lb-zoom]');
    const zoomLabel = q<HTMLElement>('[data-lb-zoom-label]');
    const open = q<HTMLAnchorElement>('[data-lb-open]');
    const verify = q<HTMLAnchorElement>('[data-lb-verify]');
    let list: HTMLAnchorElement[] = [];
    let at = 0;
    let opener: HTMLElement | null = null;

    const setZoom = (on: boolean) => {
      stage.classList.toggle('zoomed', on);
      zoom.setAttribute('aria-pressed', String(on));
      zoomLabel.textContent = on ? 'Zoom out' : 'Zoom in';
    };
    const show = (i: number) => {
      at = (i + list.length) % list.length;
      const a = list[at];
      const tile = a.closest('.tile')!;
      q<HTMLElement>('[data-lb-title]').textContent = a.dataset.title ?? '';
      q<HTMLElement>('[data-lb-issuer]').textContent = a.dataset.issuer ?? '';
      q<HTMLElement>('[data-lb-date]').textContent = a.dataset.date ? `Issued ${a.dataset.date}` : '';
      q<HTMLElement>('[data-lb-detail]').innerHTML = tile.querySelector('.detail')?.innerHTML ?? '';
      open.href = a.dataset.full ?? a.href;
      errorLink.href = open.href;
      verify.hidden = !a.dataset.verify;
      if (a.dataset.verify) verify.href = a.dataset.verify;
      setZoom(false);
      stage.scrollTo(0, 0);
      error.hidden = true;
      loading.hidden = false;
      img.classList.remove('ready');
      img.alt = a.querySelector('img')?.alt ?? '';
      if (a.dataset.w && a.dataset.h) { img.width = Number(a.dataset.w); img.height = Number(a.dataset.h); }
      img.src = a.dataset.full ?? a.href;
      const many = list.length > 1;
      q<HTMLElement>('[data-lb-prev]').hidden = !many;
      q<HTMLElement>('[data-lb-next]').hidden = !many;
    };
    img.addEventListener('load', () => { loading.hidden = true; img.classList.add('ready'); });
    img.addEventListener('error', () => { loading.hidden = true; error.hidden = false; });

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-open]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const scope = a.closest('[data-feat-track]') ?? gallery;
      list = Array.from(scope?.querySelectorAll<HTMLAnchorElement>('a[data-open]') ?? []).filter((x) => x.offsetParent !== null);
      if (!list.includes(a)) list = [a];
      opener = a;
      show(list.indexOf(a));
      lb.showModal();
      document.documentElement.classList.add('lb-open');
      q<HTMLElement>('[data-lb-close]').focus();
    });
    q<HTMLElement>('[data-lb-close]').addEventListener('click', () => lb.close());
    q<HTMLElement>('[data-lb-prev]').addEventListener('click', () => show(at - 1));
    q<HTMLElement>('[data-lb-next]').addEventListener('click', () => show(at + 1));
    zoom.addEventListener('click', () => setZoom(!stage.classList.contains('zoomed')));
    img.addEventListener('click', () => setZoom(!stage.classList.contains('zoomed')));
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (list.length < 2 || (e.target as HTMLElement).closest('a, button:not([data-lb-close])')) return;
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
    lb.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-open');
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>

<style>
  /* ---------- Header ---------- */
  .cert-hero { position: relative; overflow: hidden; padding: 88px 0 72px; border-bottom: 1px solid var(--line); background-color: var(--bg); }
  .cert-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 55% 80% at 85% 20%, rgba(59,191,178,.09), transparent 70%);
  }
  .cert-hero .container { position: relative; }
  .fan { display: none; }
  @media (min-width: 1180px) {
    .fan { display: block; position: absolute; right: 24px; top: 50%; width: 380px; height: 330px; transform: translateY(-50%); pointer-events: none; }
    .fan img {
      position: absolute; right: 0; top: 50%; width: 310px; height: auto; border-radius: 4px; background: #fff;
      border: 6px solid #fff; box-shadow: 0 30px 60px -20px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.06);
      transform: translate(calc(var(--k) * -34px), calc(-50% + (var(--k) - 1) * 48px)) rotate(calc((var(--k) - 1) * -6deg));
      filter: brightness(calc(.62 + var(--k) * .19));
    }
  }
  @media (min-width: 1180px) and (prefers-reduced-motion: no-preference) {
    .fan img { animation: fanIn .9s var(--ease) both; animation-delay: calc(var(--k) * 120ms + 150ms); }
    @keyframes fanIn { from { opacity: 0; translate: 0 26px; } to { opacity: 1; translate: 0 0; } }
  }
  .cert-hero h1, .lede, .stats, .areas { position: relative; }
  @media (min-width: 1180px) { .cert-hero .lede, .cert-hero .areas { max-width: 640px; } .cert-hero .stats { max-width: 700px; } }
  .cert-hero h1 { font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.6rem); line-height: 1.04; letter-spacing: -.035em; max-width: 15ch; margin-bottom: 22px; }
  .cert-hero h1 span { color: var(--accent-ink); }
  .lede { font-size: clamp(1.05rem, .95rem + .35vw, 1.25rem); line-height: 1.7; color: var(--ink-2); max-width: 60ch; margin: 0 0 40px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); max-width: 720px; }
  .stats div { padding: 20px 22px 18px 0; }
  .stats div + div { padding-left: 22px; border-left: 1px solid var(--line); }
  .stats dt { order: 2; font-family: var(--mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }
  .stats div { display: flex; flex-direction: column; }
  .stats dd { order: 1; margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .areas { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .areas li { font-size: .84rem; color: var(--ink-2); padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line-2); background: rgba(21,36,58,.5); }
  @media (max-width: 720px) {
    .cert-hero { padding: 56px 0 52px; }
    .stats div { padding-right: 12px; }
    .stats div + div { padding-left: 14px; }
  }

  /* ---------- Featured row ---------- */
  .featured { padding-bottom: 72px; border-bottom: 1px solid var(--line); }
  .feat-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 30px; }
  .feat-head h2 { font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3rem); margin: 0 0 12px; }
  .feat-head p { margin: 0; color: var(--muted); max-width: 60ch; font-size: 1.04rem; }
  .feat-nav { display: flex; align-items: center; gap: 10px; }
  .feat-count { font-family: var(--mono); font-size: .8rem; color: var(--muted); margin-right: 8px; }
  .feat-count b { color: var(--ink); font-weight: 500; }
  .nav-btn {
    width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: transparent; border: 1px solid var(--line-2); color: var(--ink);
    transition: border-color .2s, background .2s, opacity .2s;
  }
  .nav-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
  .nav-btn:hover:not(:disabled) { border-color: var(--accent); background: rgba(59,191,178,.1); }
  .nav-btn:disabled { opacity: .35; cursor: default; }

  .feat-viewport { position: relative; }
  .feat-track {
    list-style: none; margin: 0; display: flex; gap: 24px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none;
    padding: 30px max(24px, calc((100vw - var(--max)) / 2 + 24px)) 34px;
    scroll-padding-inline: max(24px, calc((100vw - var(--max)) / 2 + 24px));
  }
  .feat-track::-webkit-scrollbar { display: none; }
  .feat-track:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .feat-item { position: relative; flex: 0 0 clamp(290px, 42vw, 560px); scroll-snap-align: start; display: flex; }
  .feat-item > :global(.tile) { flex: 1; }
  .series { position: absolute; top: -26px; left: 2px; font-size: .64rem; color: var(--accent-ink); white-space: nowrap; }
  .feat-item.iso > :global(.tile) { background: linear-gradient(180deg, #13223A, var(--surface) 60%); }
  .feat-progress { height: 2px; background: var(--line-2); border-radius: 2px; overflow: hidden; max-width: 320px; }
