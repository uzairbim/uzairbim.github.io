---
import { software } from '../data/software';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';
const certs = (await getCollection('certificates')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="About" description={`About ${profile.name}, ${profile.title}.`}>
  <section class="page-hero blueprint">
    <div class="container">
      <div class="eyebrow">About</div>
      <h1>Civil Engineer <span class="sub">(BIM Engineer / BIM Coordinator)</span></h1>
      <p>{profile.tagline}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="prose">
        {profile.about.map((p) => <p>{p}</p>)}
        <div class="cta">
          <a class="btn btn-primary" href={url(profile.cv)} target="_blank" rel="noopener">CV</a>
          <a class="btn btn-outline" href={profile.portfolioLink} target="_blank" rel="noopener">Full portfolio (Canva)</a>
          <a class="btn btn-outline" href={url('/certificates/')}>View certificates</a>
        </div>
      </div>
      <aside class="side">
        <h3>Software</h3>
        <ul class="sw">{software.map((s) => (
          <li>
            {s.img ? (
              <img class="sw-logo" src={url(s.img)} alt="" width="28" height="28" loading="lazy" />
            ) : (
              <span class="sw-icon" style={`background:${s.color}`} aria-hidden="true">
                {s.path ? <svg viewBox="0 0 24 24"><path d={s.path} /></svg> : <span>{s.letters}</span>}
              </span>
            )}
            {s.name}
          </li>
        ))}</ul>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="eyebrow">Experience</div>
      <h2>Where I've worked</h2>
      <ol class="timeline">
        {profile.experience.map((e) => (
          <li>
            <div class="when">{e.period}</div>
            <div class="what">
              <h3>{e.role} <span class="muted">· {e.company}</span></h3>
              <div class="where">{e.place} · {e.project}</div>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div>
        <div class="eyebrow">Education</div>
        <h2>Qualifications</h2>
        <ul class="list">
          {profile.education.map((e) => (
            <li><strong>{e.title}</strong><span class="muted">{e.org} · {e.note}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="eyebrow">Certifications</div>
        <h2>Certified in</h2>
        <ul class="list">{certs.map((c) => <li><strong>{c.data.title}</strong><span class="muted">{c.data.issuer}</span></li>)}</ul>
        <p><a class="link-arrow" href={url('/certificates/')}>View certificates →</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sw { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sw li { display: flex; align-items: center; gap: 10px; font-size: .9rem; color: var(--ink-2); }
  .sw-icon { flex: none; width: 26px; height: 26px; border-radius: 6px; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: .72rem; letter-spacing: -.02em; }
  .sw-logo { flex: none; width: 28px; height: 28px; object-fit: contain; margin: -1px; }
  .sw-icon svg { width: 17px; height: 17px; fill: #fff; }
  h1 .sub { display: block; font-size: .55em; font-weight: 700; color: #d6e0ea; margin-top: .25em; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 56px; }
  .prose p { font-size: 1.08rem; color: var(--ink-2); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .side { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; align-self: start; }
  .side h3 { font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-family: var(--font); }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .timeline { list-style: none; margin: 28px 0 0; padding: 0; }
  .timeline > li { display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 26px 0; border-top: 1px solid var(--line); }
  .when { font-weight: 600; color: var(--accent-ink); font-size: .92rem; }
  .what h3 { margin-bottom: 4px; }
  .what h3 .muted { font-weight: 500; }
  .where { color: var(--muted); font-size: .9rem; margin-bottom: 10px; }
  .what ul { margin: 0; padding-left: 1.1em; color: var(--ink-2); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .list li { padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); display: flex; flex-direction: column; }
  @media (max-width: 820px) {
    .about-grid, .two { grid-template-columns: 1fr; gap: 32px; }
    .timeline > li { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
