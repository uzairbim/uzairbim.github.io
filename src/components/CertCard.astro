---
// One certificate on the Certificates page. The preview is a link to the full-size
// image, so it still works without JavaScript; with JavaScript it opens the lightbox.
import { url } from '../lib/url';
import { certImageSizes } from '../data/certImageSizes';
import { categoryOf, issuerLabel } from '../data/certMeta';

interface Props { cert: any; variant?: 'grid' | 'featured'; featured?: boolean; index?: number; }
const { cert, variant = 'grid', featured = false, index = 0 } = Astro.props;
const d = cert.data;
const Content = cert.Content;
const cat = categoryOf(d);
const size = d.image ? certImageSizes[d.image] : undefined;
const base = d.image ? d.image.replace(/^\/uploads\/certificates\//, '/uploads/certificates/thumbs/').replace(/\.jpg$/, '') : '';
const sizes = variant === 'featured'
  ? '(min-width: 1100px) 560px, (min-width: 700px) 60vw, 84vw'
  : '(min-width: 1100px) 380px, (min-width: 680px) 46vw, 92vw';
const label = issuerLabel(d);
const short = d.title.replace(/^"|"$/g, '');
---
<article class:list={['tile', `tile-${variant}`, { 'no-copy': !d.image }]} data-cat={cat} data-featured={featured ? 'true' : undefined} style={`--i:${index}`}>
  {d.image ? (
    <a class="tile-media" href={url(d.image)} target="_blank" rel="noopener"
       data-open
       data-title={short}
       data-issuer={label}
       data-date={d.date ?? ''}
       data-full={url(d.image)}
       data-verify={d.link ?? ''}
       data-w={size?.[0]} data-h={size?.[1]}
       aria-label={`View certificate: ${short}, ${label}`}>
      <span class="paper">
        <img src={url(`${base}-1040.webp`)} srcset={`${url(`${base}-640.webp`)} 640w, ${url(`${base}-1040.webp`)} 1040w`} sizes={sizes}
             width={size?.[0]} height={size?.[1]} loading={variant === 'featured' && index < 2 ? 'eager' : 'lazy'} decoding="async"
             alt={`${short} certificate issued by ${d.issuer}${d.date ? ` on ${d.date}` : ''}.`} />
      </span>
      <span class="view-pill" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
        View certificate
      </span>
    </a>
  ) : (
    <div class="tile-media empty">
      <span class="paper">
        <span class="seal" aria-hidden="true">{d.issuer.slice(0, 2).toUpperCase()}</span>
        <span class="empty-text">Certificate copy not on the website yet</span>
      </span>
    </div>
  )}
  <div class="tile-body">
    <p class="issuer">{label}</p>
    <h3>{short}</h3>
    <p class="meta">
      {d.date ? <span>{d.date}</span> : <span>Date not listed</span>}
      {d.link && (
        <a class="verified" href={d.link} target="_blank" rel="noopener" aria-label={`Verify ${short} online`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.3.9 3.1 2.8 1.6-1.2 3 1.2 3-2.8 1.6-.9 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.9-3.1-2.8-1.6 1.2-3-1.2-3 2.8-1.6.9-3.1 3.2.3z"/><path d="M8.5 12.2l2.3 2.3 4.7-4.7"/></svg>
          Verifiable
        </a>
      )}
    </p>
  </div>
  <div class="detail" hidden><Content /></div>
</article>

<style>
  .tile {
    position: relative; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
    transition: transform .45s var(--ease), border-color .3s, box-shadow .4s var(--ease);
  }
  .tile::before {
    /* Soft teal edge that fades in on hover. */
    content: ''; position: absolute; inset: -1px; border-radius: inherit; pointer-events: none;
    padding: 1px; opacity: 0; transition: opacity .35s;
    background: linear-gradient(135deg, rgba(95,211,198,.85), rgba(59,191,178,.15) 40%, rgba(192,143,95,.35) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
  }
  .tile:hover, .tile:focus-within {
    border-color: transparent;
    box-shadow: 0 24px 50px -24px rgba(0,0,0,.75), 0 0 0 1px rgba(59,191,178,.08), 0 10px 40px -18px rgba(59,191,178,.35);
  }
  .tile:hover::before, .tile:focus-within::before { opacity: 1; }

  .tile-media {
    position: relative; display: block; padding: 16px; border-radius: 15px 15px 0 0;
    background: radial-gradient(ellipse at 50% 0%, #1B2C44, #111E30 70%);
    text-decoration: none; overflow: hidden;
  }
  .tile-featured .tile-media { padding: 22px; }
  .paper {
    display: block; position: relative; overflow: hidden; border-radius: 4px; background: #fff;
    box-shadow: 0 1px 0 rgba(255,255,255,.4) inset, 0 12px 28px -10px rgba(0,0,0,.6);
    aspect-ratio: 1.414 / 1;
  }
  .paper img {
    width: 100%; height: 100%; object-fit: contain; background: #fff;
    transition: transform .6s var(--ease);
  }
  a.tile-media:hover .paper img, a.tile-media:focus-visible .paper img { transform: scale(1.035); }

  .view-pill {
    position: absolute; left: 50%; bottom: 28px; transform: translate(-50%, 8px);
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px; border-radius: 999px;
    background: rgba(11,17,24,.9); border: 1px solid rgba(95,211,198,.5); color: var(--ink);
    font-size: .86rem; font-weight: 600; white-space: nowrap;
    opacity: 0; transition: opacity .3s, transform .35s var(--ease);
    backdrop-filter: blur(6px);
  }
  .view-pill svg { width: 16px; height: 16px; fill: none; stroke: var(--accent-ink); stroke-width: 2; }
  a.tile-media:hover .view-pill, a.tile-media:focus-visible .view-pill { opacity: 1; transform: translate(-50%, 0); }
  @media (hover: none) { .view-pill { opacity: 1; left: auto; right: 24px; bottom: 24px; transform: none; font-size: .76rem; padding: 6px 11px; } }
  a.tile-media:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }

  .empty .paper { aspect-ratio: 3.2 / 1;
    display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 14px;
    background: repeating-linear-gradient(135deg, #132235 0 10px, #15263A 10px 20px);
    border: 1px dashed var(--line-2); box-shadow: none;
  }
  .seal {
    flex: 0 0 auto; width: 46px; height: 46px; font-size: .86rem; border-radius: 50%; display: grid; place-items: center;
    border: 1px solid rgba(214,168,122,.5); color: var(--bronze-ink);
    font-family: var(--display); font-weight: 800; letter-spacing: .04em;
  }
  .empty-text { font-family: var(--mono); font-size: .64rem; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); max-width: 22ch; }

  .tile-body { padding: 18px 22px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .tile-featured .tile-body { padding: 20px 26px 26px; }
  .issuer { margin: 0; font-family: var(--mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--bronze-ink); }
  h3 { margin: 0; font-size: 1.08rem; line-height: 1.35; }
  .tile-featured h3 { font-size: 1.28rem; }
  .meta { margin: auto 0 0; padding-top: 6px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-size: .86rem; }
  .verified {
    display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
    font-family: var(--mono); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-ink);
    padding: 3px 9px 3px 6px; border: 1px solid rgba(95,211,198,.35); border-radius: 999px;
  }
  .verified:hover { background: rgba(59,191,178,.1); }
  .verified svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; }

  @media (prefers-reduced-motion: reduce) {
    .tile, .paper img, .view-pill { transition: none; }
  }
</style>
