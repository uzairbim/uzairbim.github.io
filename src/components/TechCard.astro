---
// One card in the Home page "Technical Expertise in Practice" section.
import type { ShowcaseItem } from '../data/showcase';
import { profile } from '../data/profile';
import { url } from '../lib/url';
interface Props { item: ShowcaseItem; index: number; }
const { item, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const link = item.link && {
  ...item.link,
  href: item.link.href === 'portfolio' ? profile.portfolioLink : item.link.external ? item.link.href : url(item.link.href),
};
---
<article class="tech">
  <figure class="shot">
    {item.image ? (
      <img src={url(item.image)} alt={item.caption} loading="lazy" style={item.focus ? `object-position:${item.focus}` : undefined} />
    ) : (
      <div class="placeholder" role="img" aria-label={`Placeholder: ${item.caption}`}>
        <svg viewBox="0 0 240 120" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.3">
            <rect x="14" y="18" width="52" height="30" rx="4" /><rect x="14" y="72" width="52" height="30" rx="4" />
            <rect x="96" y="44" width="52" height="34" rx="4" /><rect x="176" y="44" width="52" height="34" rx="4" />
            <path d="M66 33c16 0 14 20 30 20M66 87c16 0 14-20 30-20M148 61h28" />
          </g>
          <g fill="currentColor"><circle cx="66" cy="33" r="2.6" /><circle cx="66" cy="87" r="2.6" /><circle cx="96" cy="53" r="2.6" /><circle cx="96" cy="67" r="2.6" /><circle cx="148" cy="61" r="2.6" /><circle cx="176" cy="61" r="2.6" /></g>
        </svg>
        <span class="ph-badge">Screenshot placeholder</span>
      </div>
    )}
    <span class="num">{num}</span>
  </figure>
  <div class="body">
    <h3>{item.title}</h3>
    <ul class="tags">{item.tags.map((t) => <li>{t}</li>)}</ul>
    <p>{item.text}</p>
    <div class="foot">
      <small class="caption">{item.caption}</small>
      {link && (
        <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
          {link.label} <span aria-hidden="true">{link.external ? '↗' : '→'}</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .tech { display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius); overflow: hidden; background: rgba(255,255,255,.035); transition: border-color .2s; }
  .tech:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .shot { position: relative; margin: 0; aspect-ratio: 16 / 10; background: #fff; overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .num { position: absolute; top: 12px; left: 12px; font-family: var(--display); font-size: .78rem; font-weight: 800; letter-spacing: .08em; color: #fff; background: rgba(10,22,38,.82); border: 1px solid rgba(255,255,255,.14); padding: 4px 9px; border-radius: 8px; }
  .placeholder { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 14px; background-color: var(--navy-2); color: rgba(240,162,58,.7); border-bottom: 1px dashed rgba(240,162,58,.4);
    background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; }
  .placeholder svg { width: 62%; max-width: 300px; }
  .ph-badge { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); border: 1px dashed var(--accent); border-radius: 999px; padding: 4px 12px; }
  .body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
  h3 { color: #fff; font-size: 1.12rem; line-height: 1.3; margin: 0 0 10px; }
  .tags { list-style: none; margin: 0 0 12px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-size: .74rem; font-weight: 600; padding: 2px 9px; border-radius: 999px; color: var(--accent); background: rgba(240,162,58,.1); border: 1px solid rgba(240,162,58,.28); }
  p { color: #c3d0de; font-size: .93rem; line-height: 1.6; margin: 0 0 16px; flex: 1; }
  .foot { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.1); }
  .caption { color: #8ea3b9; font-size: .8rem; }
  .foot a { color: var(--accent); font-size: .88rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .foot a:hover { text-decoration: underline; }
</style>
